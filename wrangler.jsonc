{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "push-notification-service-worker",
    "main": "src/index.ts",
    "compatibility_date": "2026-04-04",
    "observability": {
        "enabled": true
    },
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": "./assets"
    }
}